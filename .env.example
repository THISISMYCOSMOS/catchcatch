PORT=3000

# Supabase project URL. Example format only: https://your-project-ref.supabase.co
SUPABASE_URL=

# Public Supabase key used only for public Auth OTP requests.
SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Never expose this to frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Stable server-only secret for the phone-based quota subject HMAC.
# Use at least 32 random characters and never expose it to frontend code.
PHONE_IDENTITY_HMAC_SECRET=

# Current terms identifier and lowercase SHA-256 of the exact published terms document.
# Signup remains unavailable until the terms document is finalized and both values are set.
TERMS_VERSION=
TERMS_DOCUMENT_SHA256=

# Shared token for Core -> Backend internal API calls. Do not use the service role key here.
INTERNAL_API_TOKEN=

# Optional server-only Coupang Partners deeplink conversion. Enable only after
# the Partners account is finally approved and its API keys are issued.
COUPANG_PARTNERS_ENABLED=false
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
COUPANG_PARTNERS_API_BASE_URL=https://api-gateway.coupang.com
COUPANG_PARTNERS_TIMEOUT_MS=3000
