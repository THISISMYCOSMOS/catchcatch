PORT=3000

# Supabase project URL. Example format only: https://your-project-ref.supabase.co
SUPABASE_URL=

# Server-only Supabase service role key. Never expose this to frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Shared token for Core -> Backend internal API calls. Do not use the service role key here.
INTERNAL_API_TOKEN=
